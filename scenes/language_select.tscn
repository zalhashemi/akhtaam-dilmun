[sub_resource type="GDScript" id="GDScript_r3jeu"]
script/source = "extends Control

@onready var btn_english : TextureButton = $CenterContainer/VBoxContainer/HBoxContainer/BtnEnglish
@onready var btn_arabic  : TextureButton = $CenterContainer/VBoxContainer/HBoxContainer/BtnArabic
@onready var lbl_english : Label = $CenterContainer/VBoxContainer/HBoxContainer/BtnEnglish/Label
@onready var lbl_arabic  : Label = $CenterContainer/VBoxContainer/HBoxContainer/BtnArabic/Label

func _ready() -> void:
	# Force LTR on the whole scene so Arabic locale never flips layout or button order
	layout_direction = Control.LAYOUT_DIRECTION_LTR
	$CenterContainer.layout_direction = Control.LAYOUT_DIRECTION_LTR
	$CenterContainer/VBoxContainer/HBoxContainer.layout_direction = Control.LAYOUT_DIRECTION_LTR

	lbl_english.text = \"English\"
	lbl_arabic.text  = \"العربية\"
	btn_english.pressed.connect(_on_english_pressed)
	btn_arabic.pressed.connect(_on_arabic_pressed)

func _on_english_pressed() -> void:
	Global.set_language(\"en\")
	get_tree().change_scene_to_file(\"res://scenes/MainMenu.tscn\")

func _on_arabic_pressed() -> void:
	Global.set_language(\"ar\")
	get_tree().change_scene_to_file(\"res://scenes/MainMenu.tscn\")
"

